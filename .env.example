# =============================================================================
# NightAware — Environment Variables Configuration
# =============================================================================
# Copy this file to .env in the project root:
#   cp .env.example .env
#
# NEVER commit .env with real credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase Backend (PostGIS Spatial Database & POI Caching)
# -----------------------------------------------------------------------------
# Get these credentials from:
#   https://supabase.com/dashboard -> Project Settings -> API
#
# Required Supabase features:
#   - PostGIS extension enabled (CREATE EXTENSION IF NOT EXISTS postgis;)
#   - Tables: `pois`, `community_reports`, `trusted_contacts`
#   - RPC functions: `get_pois_in_corridor`, `upsert_pois`
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here

# -----------------------------------------------------------------------------
# 2. Google Maps Platform (Routes API v2 & Places API New)
# -----------------------------------------------------------------------------
# Get a key from:
#   https://console.cloud.google.com/apis/credentials
#
# Enabled APIs on Google Cloud Console:
#   1. Routes API (v2:computeRoutes) — for multi-alternative live road routing
#   2. Places API (New) (v1/places:searchText & searchNearby) — for 24/7 night POIs
#   3. Geocoding API — for address search and reverse geocoding
#   4. Maps SDK for Android — for react-native-maps native rendering
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
