# Supabase Auth — copy to .env and fill in your project values.
# Get these from: https://supabase.com/dashboard → Project Settings → API
#
# NEVER commit .env to git.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Google Maps — required for react-native-maps on Android and Google Routes & Places API.
# Get a key from: https://console.cloud.google.com/apis/credentials
# Enable: Maps SDK for Android, Places API (New), Routes API, Geocoding API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
